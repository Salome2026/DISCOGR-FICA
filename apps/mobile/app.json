{
  "expo": {
    "name": "VPO Corp",
    "slug": "vpo-corp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vpocorp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.vpocorp.app",
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "com.vpocorp.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://www.vpocorp.com"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
